---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { VIETNAM_CAREER_DATA, EXAM_BLOCKS_INFO } from '../data/vietnamCareerData';
import { slugify } from '../utils/slugify';
import schoolsData from '../data/vietnamSchools.json';

const totalSchools = schoolsData.length;
const totalCareers = VIETNAM_CAREER_DATA.length;
const totalBlocks = Object.keys(EXAM_BLOCKS_INFO).length;

const featuredCareers = VIETNAM_CAREER_DATA.filter(c => c.isHot2026).slice(0, 6);
const featuredSchools = schoolsData.filter((s: any) => s.lat && s.lng).slice(0, 4);

const categoryColors: Record<string, string> = {
  'Công nghệ Thông tin': 'badge-primary',
  'Y Dược & Sức Khỏe': 'badge-teal',
  'Kinh Tế & Quản Lý': 'badge-gold',
  'Truyền Thông & Marketing': 'badge-violet',
  'Nghệ Thuật & Thiết Kế': 'badge-rose',
  'Cơ Khí & Kỹ Thuật': 'badge-gold',
};
---

<Layout title="HướngNghiệp VN — Định Hướng Nghề Nghiệp & Trường Học Việt Nam">
  <Header currentPath="/" />

  <!-- ═══════════════════════ HERO ═══════════════════════ -->
  <section class="relative min-h-[92vh] flex items-center justify-center overflow-hidden">
    <!-- Grid pattern overlay -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 60px 60px;"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 text-center">
      <!-- Label -->
      <div class="inline-flex items-center gap-2 mb-6 animate-fade-up" style="animation-delay: 0.1s; opacity: 0; animation-fill-mode: forwards;">
        <span class="section-label">🇻🇳 Nền tảng định hướng nghề nghiệp</span>
      </div>

      <!-- Headline -->
      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black mb-6 leading-[1.05] tracking-tight animate-fade-up"
          style=" animation-delay:0.2s; opacity:0; animation-fill-mode:forwards;">
        Chọn Đúng Ngành,<br/>
        <span class="gradient-text">Chọn Đúng Tương Lai</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto leading-relaxed mb-10 animate-fade-up"
         style="animation-delay:0.35s; opacity:0; animation-fill-mode:forwards;">
        Khám phá mức lương thực tế, so sánh ngành học, tìm trường phù hợp —
        <br class="hidden sm:block"/>tất cả dữ liệu cập nhật từ thị trường lao động Việt Nam.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-3 justify-center mb-16 animate-fade-up"
           style="animation-delay:0.45s; opacity:0; animation-fill-mode:forwards;">
        <a href="/careers" class="btn-primary text-base py-3.5 px-7">
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          Khám phá ngành nghề
        </a>
        <a href="/careers/compare" class="btn-secondary text-base py-3.5 px-7">
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M9 19V5l-7 7 7 7M15 5v14l7-7-7-7"/>
          </svg>
          So sánh ngành học
        </a>
        <a href="/schools" class="btn-secondary text-base py-3.5 px-7">
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
          </svg>
          Tìm trường học
        </a>
      </div>

      <!-- Stats row -->
      <div class="grid grid-cols-3 gap-4 max-w-lg mx-auto animate-fade-up"
           style="animation-delay:0.55s; opacity:0; animation-fill-mode:forwards;">
        {[
          { num: totalCareers, label: 'Ngành Nghề', unit: '+' },
          { num: totalSchools, label: 'Trường Học', unit: '+' },
          { num: totalBlocks, label: 'Khối Thi', unit: '' },
        ].map(s => (
          <div class="card p-4 text-center">
            <div class="stat-number text-3xl gradient-text">{s.num}{s.unit}</div>
            <div class="text-xs text-slate-500 mt-1 font-medium">{s.label}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-float">
      <span class="text-xs text-slate-600">Cuộn xuống</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#475569" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
      </svg>
    </div>
  </section>

  <!-- ═══════════════════════ FEATURES STRIP ═══════════════════════ -->
  <section class="py-12 border-y border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {[
          { icon: '💰', title: 'Lương Thực Tế', desc: 'Dữ liệu thị trường VN 2024' },
          { icon: '🔀', title: 'So Sánh Ngành', desc: 'Radar chart đa chiều' },
          { icon: '🏫', title: '262+ Trường', desc: 'ĐH, CĐ, Trường Nghề' },
          { icon: '🗺️', title: 'Lộ Trình THPT', desc: 'Lớp 10 → 11 → 12' },
        ].map(f => (
          <div class="flex items-center gap-3 p-4 card">
            <span class="text-2xl shrink-0">{f.icon}</span>
            <div>
              <div class="text-sm font-bold text-white">{f.title}</div>
              <div class="text-xs text-slate-500 mt-0.5">{f.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ FEATURED CAREERS ═══════════════════════ -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-10">
        <div>
          <span class="section-label mb-3 block w-fit">🔥 Xu hướng 2026</span>
          <h2 class="text-3xl font-black text-white" >
            Ngành Nghề Hot 2026
          </h2>
          <p class="text-slate-500 text-sm mt-2">Các ngành công nghệ cao, bán dẫn, AI & dịch vụ số có nhu cầu nhân lực lớn nhất tại Việt Nam</p>
        </div>
        <a href="/careers" class="btn-ghost hidden md:flex">
          Xem tất cả →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {featuredCareers.map((career) => {
          const badgeClass = categoryColors[career.category] || 'badge-primary';
          const maxSalary = career.salariesVND.lead;
          const minSalary = career.salariesVND.entry;
          return (
            <a
              href={`/careers/${career.id}`}
              class="card card-hover p-5 group block"
            >
              <!-- Header -->
              <div class="flex items-start justify-between mb-4">
                <div class="flex items-center gap-3">
                  <span class="text-3xl">{career.icon}</span>
                  <div>
                    <div class="flex items-center gap-1.5 mb-1">
                      <span class={`badge ${badgeClass}`}>{career.category}</span>
                      {career.isHot2026 && <span class="badge badge-rose">🔥 HOT 2026</span>}
                    </div>
                    <h3 class="text-sm font-bold text-white leading-snug group-hover:text-indigo-300 transition-colors">{career.title}</h3>
                  </div>
                </div>
              </div>

              <!-- Description -->
              <p class="text-xs text-slate-500 leading-relaxed mb-4 line-clamp-2">{career.description}</p>

              <!-- Salary range -->
              <div class="flex items-center justify-between text-xs mb-3">
                <span class="text-slate-500">Mức lương</span>
                <span class="text-emerald-400 font-bold">{(minSalary/1000000).toFixed(0)}M → {(maxSalary/1000000).toFixed(0)}M VNĐ/tháng</span>
              </div>

              <!-- Salary bar -->
              <div class="progress-bar mb-4">
                <div class="progress-fill" style={`width: ${Math.min(100, (career.salariesVND.mid / 120000000) * 100)}%`}></div>
              </div>

              <!-- Bottom meta -->
              <div class="flex items-center gap-2 flex-wrap">
                {career.primaryExamBlocks.slice(0, 3).map(b => (
                  <span class="badge badge-primary">{b}</span>
                ))}
                <span class="badge badge-teal ml-auto">{career.durationYears} năm</span>
              </div>
            </a>
          );
        })}
      </div>

      <div class="mt-8 text-center md:hidden">
        <a href="/careers" class="btn-secondary">Xem tất cả ngành nghề →</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ EXAM BLOCKS ═══════════════════════ -->
  <section class="py-16 border-y border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <span class="section-label mb-3 block mx-auto w-fit">📚 Khối thi THPT</span>
        <h2 class="text-3xl font-black text-white" >Chọn Ngành Theo Thế Mạnh Của Bạn</h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {Object.entries(EXAM_BLOCKS_INFO).map(([block, info]) => (
          <a href={`/careers?block=${block}`} class="card card-hover p-5 text-center group">
            <div class="text-2xl font-black gradient-text mb-2" >{block}</div>
            <div class="text-xs text-slate-400 font-semibold mb-2">{info.subjects.join(' · ')}</div>
            <p class="text-xs text-slate-600 leading-relaxed">{info.desc.split('-')[0].trim()}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ FEATURED SCHOOLS ═══════════════════════ -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-10">
        <div>
          <span class="section-label mb-3 block w-fit">🏛️ Trường học</span>
          <h2 class="text-3xl font-black text-white" >
            Các Trường Nổi Bật
          </h2>
        </div>
        <a href="/schools" class="btn-ghost hidden md:flex">Xem {totalSchools}+ trường →</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {featuredSchools.map((school: any) => (
          <a href={`/schools/${slugify(school.name)}`}
             class="card card-hover p-5 group block">
            <div class="text-2xl mb-3">🏛️</div>
            <div class="text-xs badge badge-teal mb-2">{school.typeLabel || 'Đại học'}</div>
            <h3 class="text-sm font-bold text-white leading-snug mb-2 group-hover:text-indigo-300 transition-colors">
              {school.name}
            </h3>
            <p class="text-xs text-slate-500">{school.province}</p>
            <div class="mt-3 text-xs text-slate-600">
              {school.majors?.length || 0} ngành · {(school.avgTuitionPerYearVND / 1000000).toFixed(0)}M/năm
            </div>
          </a>
        ))}
      </div>
      <div class="mt-8 text-center md:hidden">
        <a href="/schools" class="btn-secondary">Xem tất cả trường →</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ CTA BANNER ═══════════════════════ -->
  <section class="py-16 px-4">
    <div class="max-w-3xl mx-auto text-center card p-12" style="background: linear-gradient(135deg, rgba(79,110,247,0.15), rgba(139,92,246,0.1)); border-color: rgba(79,110,247,0.25);">
      <div class="text-4xl mb-4">🔀</div>
      <h2 class="text-2xl font-black text-white mb-3" >Chưa chắc chọn ngành nào?</h2>
      <p class="text-slate-400 text-sm mb-6">Dùng công cụ So Sánh Ngành để xem lương, chi phí học và thời gian hoàn vốn của nhiều ngành cùng một lúc.</p>
      <a href="/careers/compare" class="btn-primary text-base py-3.5 px-8">
        Bắt đầu so sánh ngay →
      </a>
    </div>
  </section>
</Layout>
