---
import AICareerAdvisor from './react/AICareerAdvisor';

interface Props {
  pageContext?: Record<string, any> | null;
}

const { pageContext = null } = Astro.props;

// Evaluate provider availability strictly on server-side
const hasGemini = Boolean((process.env.GOOGLE_GENERATIVE_AI_API_KEY || import.meta.env.GOOGLE_GENERATIVE_AI_API_KEY || '').trim());
const hasGroq = Boolean((process.env.GROQ_API_KEY || import.meta.env.GROQ_API_KEY || '').trim());
const hasAlibaba = Boolean((process.env.ALIBABA_AI_API_KEY || import.meta.env.ALIBABA_AI_API_KEY || '').trim());
const enabledFlag = import.meta.env.PUBLIC_ENABLE_AI !== 'false';

const enabled = enabledFlag && (hasGemini || hasGroq || hasAlibaba);
---

{enabled && <AICareerAdvisor client:idle enabled={enabled} pageContext={pageContext} />}
